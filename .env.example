# ── Supabase Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your Supabase project credentials:
# Project Settings -> API -> Project URL & anon/public API Key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Pipedream Webhook Integration ──────────────────────────────
# Optional: Set default Pipedream HTTP webhook endpoint for automated emails
VITE_PIPEDREAM_WEBHOOK_URL=https://eoxxxxxxxxx.m.pipedream.net

